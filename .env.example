# API server
API_PORT=8001
WORKERS=1
LOG_LEVEL=INFO

# Processing defaults
MAX_TOKENS=512
OVERLAP=100

# File and request limits
MAX_FILE_SIZE_MB=100
MAX_FILES=10
MAX_TABLE_ROWS=500000
MAX_CONCURRENT_REQUESTS=2
REQUEST_TIMEOUT_SECONDS=1800
CONCURRENCY_ACQUIRE_TIMEOUT=60

# Model preload
# Comma-separated model keys, for example:
# PRELOAD_MODELS=BAAI/bge-m3,multilingual-e5-large
PRELOAD_MODELS=

# Hugging Face
# Set only when you need private/gated model access.
HF_TOKEN=

# GPU / CUDA
CUDA_VISIBLE_DEVICES=0

# Authentication
# If empty, authentication is disabled.
CHUNKING_AUTH_TOKEN=change-this-token
